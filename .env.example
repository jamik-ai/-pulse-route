# Путь к распакованному датасету хакатона (папки train/ test/ validate/ labels/)
DATASET_DIR=./data
# Вход на дашборд (обязательно смените пароль перед публикацией)
DASH_USER=jury
DASH_PASSWORD=change-me
# Дополнительные учётки: login:password,login2:password2
DASH_EXTRA_USERS=
# Секрет подписи сессий: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
# Ключ JavaScript API Яндекс Карт (необязательно)
YANDEX_MAPS_KEY=
# Сервер маршрутизации для путей по дорогам (для большого парка — свой контейнер osrm/osrm-backend)
ROUTER_URL=https://routing.openstreetmap.de/routed-car
# Воспроизведение архива: скорость (1 — реальное время), начало окна и длительность, ч
AUTO_REPLAY=1
AUTO_REPLAY_SPEED=1
AUTO_REPLAY_START=2026-01-06 06:00
AUTO_REPLAY_HOURS=13
